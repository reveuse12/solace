    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reveuse12.solace"
    },
    "android": {
      "package": "com.reveuse12.solace",
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "solace",
    "extra": {
      "eas": {
        "projectId": "5a21265e-480f-40c5-9a17-e9928f44a788"
      }
    },
    "plugins": [
      "expo-secure-store",
